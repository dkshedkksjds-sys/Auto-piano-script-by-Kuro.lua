local shiftedKeys = {
    ["!"]=Enum.KeyCode.One,["@"]=Enum.KeyCode.Two,["#"]=Enum.KeyCode.Three,["$"]=Enum.KeyCode.Four,
    ["%"]=Enum.KeyCode.Five,["^"]=Enum.KeyCode.Six,["&"]=Enum.KeyCode.Seven,["*"]=Enum.KeyCode.Eight,
    ["("]=Enum.KeyCode.Nine,[")"]=Enum.KeyCode.Zero,["_"]=Enum.KeyCode.Minus,["+"]=Enum.KeyCode.Equals,
    ["{"]=Enum.KeyCode.LeftBracket,["}"]=Enum.KeyCode.RightBracket,["|"]=Enum.KeyCode.BackSlash,
    [":"]=Enum.KeyCode.Semicolon,['"']=Enum.KeyCode.Quote,["<"]=Enum.KeyCode.Comma,[">"]=Enum.KeyCode.Period,
    ["?"]=Enum.KeyCode.Slash,["~"]=Enum.KeyCode.Backquote
}

local function resolveKey(char)
    if shiftedKeys[char] then
        return shiftedKeys[char], true
    end

    local lower = char:lower()

    if normalKeys[lower] then
        return normalKeys[lower], char ~= lower
    end

    return nil, false
end

local function tap(char)
    local key, shift = resolveKey(char)

    if not key then
        return
    end

    if shift then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
    end

    VirtualInputManager:SendKeyEvent(true, key, false, game)
    VirtualInputManager:SendKeyEvent(false, key, false, game)

    if shift then
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    end
end

local function chord(text)
    local keys = {}
    local needsShift = false

    for i = 1, #text do
        local key, shift = resolveKey(text:sub(i, i))

        if key then
            keys[#keys + 1] = key
            if shift then
                needsShift = true
            end
        end
    end

    if needsShift then
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
    end

    for _, key in ipairs(keys) do
        VirtualInputManager:SendKeyEvent(true, key, false, game)
    end

    task.wait(0.008)

    for i = #keys, 1, -1 do
        VirtualInputManager:SendKeyEvent(false, keys[i], false, game)
    end

    if needsShift then
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.LeftShift, false, game)
    end
end

local function parse(text)
    local events = {}
    local i = 1

    while i <= #text do
        local c = text:sub(i, i)

        if c == "[" then
            local close = text:find("]", i + 1, true)

            if close then
                local value = text:sub(i + 1, close - 1)

                if value ~= "" then
                    events[#events + 1] = {
                        type = "chord",
                        value = value
                    }
                end

                i = close + 1
            else
                i += 1
            end
        elseif c == "|" or c == "-" then
            events[#events + 1] = {
                type = "delay"
            }

            i += 1
        elseif c == " " or c == "\n" or c == "\r" or c == "\t" then
            events[#events + 1] = {
                type = "gap"
            }

            i += 1
        else
            events[#events + 1] = {
                type = "note",
                value = c
            }

            i += 1
        end
    end

    return events
end

local function getBeat()
    local low = math.min(minBPM, maxBPM)
    local high = math.max(minBPM, maxBPM)

    if low == high then
        return 60 / low
    end

    return 60 / math.random(low, high)
end

local function playSong()
    local text = customSheet ~= "" and customSheet or songs[selectedSong]

    if not text or text == "" then
        playing = false
        return
    end

    stopPlayback = false

    task.wait(countdown)

    if not playing or stopPlayback then
        return
    end

    for _, event in ipairs(parse(text)) do
        if not playing or stopPlayback then
            break
        end

        if event.type == "chord" then
            chord(event.value)
            task.wait(getBeat() * 0.5)
        elseif event.type == "note" then
            tap(event.value)
            task.wait(getBeat() * 0.5)
        elseif event.type == "delay" then
            task.wait(0.1)
        elseif event.type == "gap" then
            task.wait(getBeat() * 0.25)
        end
    end

    playing = false
end

